{
  "hosting": {
    "public": "dist",
    "predeploy": "node scripts/build-cloudflare.mjs",
    "ignore": [
      "_redirects",
      "**/.*"
    ],
    "cleanUrls": true,
    "trailingSlash": false
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ],
  "database": {
    "rules": "database.production.rules.json"
  }
}
