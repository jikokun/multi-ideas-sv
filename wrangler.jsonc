{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "multi-ideas-sv",
  "compatibility_date": "2026-11-10",
  "build": {
    "command": "node scripts/build-cloudflare.mjs"
  },
  "assets": {
    "directory": "./dist",
    "html_handling": "none",
    "not_found_handling": "404-page"
  }
}
