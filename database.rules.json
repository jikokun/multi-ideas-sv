{
  "rules": {
    ".read": false,
    ".write": false,
    "sensunshop": {
      ".read": true,
      ".write": "auth != null",
      "presence": {
        ".read": true,
        ".write": true
      }
    },
    "sensun_shop": {
      ".read": true,
      ".write": "auth != null"
    },
    "comments": {
      ".read": true,
      ".write": true
    },
    "laboratorio_ventas": {
      ".read": true,
      ".write": true
    },
    "test_conexion": {
      ".read": true,
      ".write": true
    },
    "users": {
      ".read": true,
      "$uid": {
        ".read": true,
        ".write": "auth != null && (auth.uid === $uid || auth.token.admin === true)"
      }
    },
    "stream": {
      ".read": true,
      ".write": true,
      "usuarios": {
        ".indexOn": ["jikopuntos", "totalGastado", "asistenciasCount", "nivel", "ultimaActividad"]
      },
      "transmisiones": {
        ".indexOn": ["inicioTimestamp", "numeroStream", "estado"]
      },
      "tienda": {
        "transacciones": {
          ".indexOn": ["timestamp", "usuarioNorm"]
        },
        "asistencias": {
          ".indexOn": ["timestamp", "usuarioNorm"]
        }
      }
    }
  }
}

