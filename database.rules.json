{
  "rules": {
    ".read": false,
    ".write": false,
    "sensunshop": {
      ".read": true,
      ".write": "auth != null",
      "presence": {
        ".read": true,
        ".write": true
      }
    },
    "sensun_shop": {
      ".read": true,
      ".write": "auth != null"
    },
    "comments": {
      ".read": true,
      ".write": true
    },
    "laboratorio_ventas": {
      ".read": true,
      ".write": true
    },
    "test_conexion": {
      ".read": true,
      ".write": true
    },
    "users": {
      ".read": true,
      "$uid": {
        ".read": true,
        ".write": "auth != null && (auth.uid === $uid || auth.token.admin === true)"
      }
    },
    "stream": {
      "spotify_auth": {
        ".read": false,
        ".write": false
      },
      "spotify_live": {
        ".read": true,
        ".write": true
      },
      "usuarios": {
        ".read": true,
        ".write": true,
        ".indexOn": ["jikopuntos", "totalGastado", "asistenciasCount", "nivel", "ultimaActividad"]
      },
      "transmisiones": {
        ".read": true,
        ".write": true,
        ".indexOn": ["inicioTimestamp", "numeroStream", "estado"]
      },
      "transmisiones_stats": {
        ".read": true,
        ".write": true
      },
      "widgets": {
        ".read": true,
        ".write": true
      },
      "overlays": {
        ".read": true,
        ".write": true
      },
      "tienda": {
        ".read": true,
        ".write": true,
        "transacciones": {
          ".indexOn": ["timestamp", "usuarioNorm"]
        },
        "asistencias": {
          ".indexOn": ["timestamp", "usuarioNorm"]
        }
      },
      "vinculaciones": {
        ".read": true,
        ".write": true
      },
      "banco": {
        ".read": true,
        ".write": true
      }
    }
  }
}

