{
  "rules": {
    ".read": false,
    ".write": false,
    "sensunshop": {
      "businesses": {
        ".read": true,
        ".write": "auth != null"
      },
      "news": {
        ".read": true,
        ".write": "auth != null"
      },
      "offers": {
        ".read": true,
        ".write": "auth != null"
      },
      "ratings": {
        ".read": true,
        ".write": "auth != null"
      },
      "presence": {
        ".read": true,
        ".write": true
      },
      "users": {
        ".read": true,
        ".write": "auth != null"
      }
    },
    "users": {
      ".read": true,
      "$uid": {
        ".read": true,
        ".write": "auth != null && (auth.uid === $uid || auth.token.admin === true)"
      }
    }
  }
}
