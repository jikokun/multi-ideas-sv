{
  "rules": {
    ".read": false,
    ".write": false,
    "sensunshop": {
      "businesses": {
        ".read": true,
        ".write": "auth != null",
        ".indexOn": ["type", "category", "isActive", "hasOffer"]
      },
      "news": {
        ".read": true,
        ".write": "auth != null",
        ".indexOn": ["timestamp", "isActive", "badge"]
      },
      "bulletins": {
        ".read": true,
        ".write": "auth != null"
      },
      "boletines": {
        ".read": true,
        ".write": "auth != null"
      },
      "offers": {
        ".read": true,
        ".write": "auth != null"
      },
      "ratings": {
        ".read": true,
        "$businessId": {
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || auth.token.admin === true)"
          }
        }
      },
      "presence": {
        ".read": true,
        ".write": true
      },
      "users": {
        "$uid": {
          ".read": "auth != null && (auth.uid === $uid || auth.token.admin === true)",
          ".write": "auth != null && (auth.uid === $uid || auth.token.admin === true)"
        }
      }
    },
    "sensun_shop": {
      ".read": true,
      ".write": "auth != null"
    },
    "comments": {
      ".read": true,
      "$businessId": {
        "$commentId": {
          ".write": "auth != null && (!data.exists() || data.child('uid').val() === auth.uid || auth.token.admin === true)"
        }
      }
    },
    "laboratorio_ventas": {
      "multiideas_catalogo": {
        ".read": true,
        ".write": "auth != null"
      },
      "users": {
        "$uid": {
          ".read": "auth != null && (auth.uid === $uid || auth.token.admin === true)",
          ".write": "auth != null && (auth.uid === $uid || auth.token.admin === true)"
        }
      }
    },
    "test_conexion": {
      ".read": true,
      ".write": "auth != null"
    },
    "multiideas_catalogo": {
      ".read": true,
      ".write": "auth != null"
    },
    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.admin === true)",
        ".write": "auth != null && (auth.uid === $uid || auth.token.admin === true)"
      }
    },
    "stream": {
      "spotify_auth": {
        ".read": false,
        ".write": false
      },
      "spotify_live": {
        ".read": true,
        ".write": true
      },
      "usuarios": {
        ".read": true,
        ".write": true,
        ".indexOn": ["jikopuntos", "totalGastado", "asistenciasCount", "nivel", "ultimaActividad"]
      },
      "transmisiones": {
        ".read": true,
        ".write": true,
        ".indexOn": ["inicioTimestamp", "numeroStream", "estado"]
      },
      "transmisiones_stats": {
        ".read": true,
        ".write": true
      },
      "widgets": {
        ".read": true,
        ".write": true
      },
      "overlays": {
        ".read": true,
        ".write": true
      },
      "tienda": {
        ".read": true,
        ".write": true,
        "transacciones": {
          ".indexOn": ["timestamp", "usuarioNorm"]
        },
        "asistencias": {
          ".indexOn": ["timestamp", "usuarioNorm"]
        }
      },
      "vinculaciones": {
        ".read": true,
        ".write": true
      },
      "banco": {
        ".read": true,
        ".write": true
      }
    }
  }
}
