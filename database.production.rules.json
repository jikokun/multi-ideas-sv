{
  "rules": {
    ".read": false,
    ".write": false,
    "sensunshop": {
      "presence": {
        ".read": true,
        ".write": true
      },
      "$other": {
        ".write": "auth != null && $other !== 'businesses' && $other !== 'users'",
        ".read": "$other !== 'users'"
      },
      "businesses": {
        "$businessId": {
          ".write": "auth != null && auth.token.admin === true && (!newData.exists() || (newData.child('hasCatalog').val() === data.child('hasCatalog').val() && newData.child('catalogUid').val() === data.child('catalogUid').val() && newData.child('catalogUrl').val() === data.child('catalogUrl').val()))"
        },
        ".read": true
      },
      "users": {
        ".read": "auth != null && auth.token.admin === true",
        "$uid": {
          ".read": "auth != null && (auth.uid === $uid || auth.token.admin === true)",
          ".write": "auth != null && (auth.uid === $uid || auth.token.admin === true)"
        }
      }
    },
    "sensun_shop": {
      ".read": true,
      ".write": "auth != null"
    },
    "wolftrack": {
      ".read": true,
      "materials": {
        ".read": true,
        "$uid": {
          ".read": true,
          ".write": "auth != null && (auth.uid == $uid || auth.token.email == 'joel.claroso@gmail.com')"
        }
      }
    },
    "comments": {
      ".read": true,
      ".write": true
    },
    "laboratorio_ventas": {
      ".read": true,
      ".write": true
    },
    "test_conexion": {
      ".read": true,
      ".write": true
    },
    "users": {
      ".read": true,
      "$uid": {
        ".read": true,
        ".write": "auth != null && (auth.uid === $uid || auth.token.admin === true)"
      }
    },
    "stream": {
      "spotify_auth": {
        ".read": false,
        ".write": false
      },
      "spotify_live": {
        ".read": true,
        ".write": true
      },
      "usuarios": {
        ".read": true,
        ".write": true,
        ".indexOn": [
          "jikopuntos",
          "totalGastado",
          "asistenciasCount",
          "nivel",
          "ultimaActividad"
        ]
      },
      "transmisiones": {
        ".read": true,
        ".write": true,
        ".indexOn": [
          "inicioTimestamp",
          "numeroStream",
          "estado"
        ]
      },
      "transmisiones_stats": {
        ".read": true,
        ".write": true
      },
      "widgets": {
        ".read": true,
        ".write": true
      },
      "overlays": {
        ".read": true,
        ".write": true
      },
      "tienda": {
        ".read": true,
        ".write": true,
        "transacciones": {
          ".indexOn": [
            "timestamp",
            "usuarioNorm"
          ]
        },
        "asistencias": {
          ".indexOn": [
            "timestamp",
            "usuarioNorm"
          ]
        }
      },
      "vinculaciones": {
        ".read": true,
        ".write": true
      },
      "banco": {
        ".read": true,
        ".write": true
      }
    }
  }
}
